# ---- Database (MySQL 8) ----
DATABASE_URL=mysql+pymysql://assetdesk:change-me@127.0.0.1:3306/assetdesk?charset=utf8mb4

# ---- App ----
# Long random string used to sign session cookies: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
# Public URL of this app (used to build OAuth redirect URIs)
BASE_URL=http://localhost:8000
# Comma-separated emails that are always Admin and can always manage people & settings
ADMIN_EMAILS=it.head@yourcompany.com
# Where uploaded invoices and chat attachments are stored
UPLOAD_DIR=./uploads
# Set true only on your laptop to sign in without SSO (never in production)
DEV_LOGIN=false
# true when served over HTTPS (marks the session cookie Secure)
COOKIE_SECURE=false

# ---- Microsoft Entra ID (Azure AD) ----
# App registration > redirect URI: {BASE_URL}/auth/callback/microsoft
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# ---- Google Workspace ----
# OAuth client (Web) > authorised redirect URI: {BASE_URL}/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Claude API (invoice reading + reply suggestions; optional) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
